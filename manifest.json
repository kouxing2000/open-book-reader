{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "short_name": "Open Book",
  "version": "1.7.1",
  "default_locale": "en",
  "description": "__MSG_extSummary__",
  "homepage_url": "https://kouxing2000.github.io/open-book-reader/",
  "minimum_chrome_version": "102",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["activeTab", "scripting", "storage", "contextMenus"],
  "optional_permissions": ["downloads"],
  "optional_host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "src/background.js"
  },
  "action": {
    "default_title": "__MSG_actionTitle__",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_ui": {
    "page": "src/options/options.html",
    "open_in_tab": true
  },
  "commands": {
    "toggle-reader": {
      "suggested_key": {
        "default": "Alt+B",
        "mac": "Alt+B"
      },
      "description": "__MSG_cmdToggleReader__"
    },
    "toggle-gallery": {
      "suggested_key": {
        "default": "Alt+Shift+B",
        "mac": "Alt+Shift+B"
      },
      "description": "__MSG_cmdToggleGallery__"
    }
  }
}
